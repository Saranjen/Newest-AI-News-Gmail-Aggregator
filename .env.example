# Copy to .env and fill in values:
#   cp .env.example .env
#
# Variables documented in README → "Environment variables" → ".env (local)"

# --- OpenAI ---
OPENAI_API_KEY=

# --- Email (Gmail SMTP) ---
MY_EMAIL=
APP_PASSWORD=

# Optional: explicit recipient / alternate names (also used by GitHub Actions secrets)
# EMAIL_SENDER=
# EMAIL_RECIPIENT=
# GMAIL_APP_PASSWORD=

# --- Database ---
# Local: leave DATABASE_URL empty and omit USE_DATABASE_URL (or false) to use POSTGRES_* only.
# Local with URL: set USE_DATABASE_URL=true and set DATABASE_URL.
# GitHub Actions: set DATABASE_URL (and other secrets) in the repo — not in this file.

DATABASE_URL=
USE_DATABASE_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_aggregator
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Optional pipeline tuning ---
# PIPELINE_HOURS=24
# EMAIL_DIGEST_HOURS=

# --- Optional YouTube proxy ---
# PROXY_USERNAME=
# PROXY_PASSWORD=

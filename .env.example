# Copy to .env and fill in values:
#   cp .env.example .env

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Email (Gmail SMTP) ---
# Preferred names (also used by GitHub Actions):
EMAIL_SENDER=you@gmail.com
EMAIL_RECIPIENT=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Legacy names (still supported if the three above are unset):
# MY_EMAIL=you@gmail.com
# APP_PASSWORD=your-16-char-app-password

# --- Database: local Docker (this repo's compose defaults to host port 5433) ---
# Leave DATABASE_URL unset or commented for local runs — the app uses POSTGRES_*.
# Do NOT put a cloud DATABASE_URL here unless you set USE_DATABASE_URL=true on purpose.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_aggregator
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Optional: same DB as a single URL (only used if USE_DATABASE_URL=true)
# USE_DATABASE_URL=true
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_news_aggregator

# --- Optional pipeline tuning ---
# PIPELINE_HOURS=24
# EMAIL_DIGEST_HOURS=

# --- Optional YouTube proxy ---
# PROXY_USERNAME=
# PROXY_PASSWORD=
